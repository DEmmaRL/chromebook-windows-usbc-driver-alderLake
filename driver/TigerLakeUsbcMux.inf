; SPDX-License-Identifier: MIT
;
; TigerLakeUsbcMux.inf - USB-C mux driver for Tiger Lake Chromebooks (PMC IPC, ACPI\INTC1026)
;

[Version]
Signature   = "$WINDOWS NT$"
Class       = System
ClassGuid   = {4d36e97d-e325-11ce-bfc1-08002be10318}
Provider    = %ProviderName%
DriverVer   = 11/04/2026,1.0.0.0
CatalogFile = TigerLakeUsbcMux.cat
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
TigerLakeUsbcMux.sys = 1,,

[Manufacturer]
%ProviderName% = Standard,NTamd64.10.0...19041

[Standard.NTamd64.10.0...19041]
%TigerLakeUsbcMux.DeviceDesc% = TigerLakeUsbcMux_Device, ACPI\INTC1026
%MuxAgent.DeviceDesc%         = TigerLakeUsbcMux_NoFunction, ACPI\INTC105C
%Iom.DeviceDesc%              = TigerLakeUsbcMux_NoFunction, ACPI\INTC1072

; INTC105C (\_SB.PCI0.PMC.MUX) only describes the ports, which TigerLakeUsbcMux reads from its parent.
; INTC1072 (\_SB.IOM) holds the IOM status registers, which TigerLakeUsbcMux reads directly.
; Neither needs a function driver: install them without one so they no longer show as unknown.
[TigerLakeUsbcMux_NoFunction.NT]

[TigerLakeUsbcMux_NoFunction.NT.Services]
AddService = , %SPSVCINST_ASSOCSERVICE%

[TigerLakeUsbcMux_Device.NT]
CopyFiles = TigerLakeUsbcMux_CopyFiles

[TigerLakeUsbcMux_CopyFiles]
TigerLakeUsbcMux.sys

[TigerLakeUsbcMux_Device.NT.HW]
AddReg = TigerLakeUsbcMux_Security_AddReg

; The diagnostic IOCTLs are restricted to SYSTEM and Administrators.
[TigerLakeUsbcMux_Security_AddReg]
HKR,,Security,,"D:P(A;;GA;;;SY)(A;;GA;;;BA)"

[TigerLakeUsbcMux_Device.NT.Services]
AddService = TigerLakeUsbcMux, %SPSVCINST_ASSOCSERVICE%, TigerLakeUsbcMux_Service

[TigerLakeUsbcMux_Service]
DisplayName   = %TigerLakeUsbcMux.ServiceDesc%
ServiceType   = 1               ; SERVICE_KERNEL_DRIVER
StartType     = 3               ; SERVICE_DEMAND_START
ErrorControl  = 1               ; SERVICE_ERROR_NORMAL
ServiceBinary = %13%\TigerLakeUsbcMux.sys

[TigerLakeUsbcMux_Device.NT.Wdf]
KmdfService = TigerLakeUsbcMux, TigerLakeUsbcMux_KmdfService

[TigerLakeUsbcMux_KmdfService]
KmdfLibraryVersion = 1.15

[Strings]
SPSVCINST_ASSOCSERVICE       = 0x00000002
ProviderName                 = "Open Source Driver"
DiskName                     = "Tiger Lake PMC USB-C Mux Installation Disk"
TigerLakeUsbcMux.DeviceDesc  = "Tiger Lake PMC USB-C Mux (Chromebook)"
TigerLakeUsbcMux.ServiceDesc = "Tiger Lake PMC USB-C Mux Service"
MuxAgent.DeviceDesc          = "Tiger Lake PMC USB-C Mux Agent (Chromebook)"
Iom.DeviceDesc               = "Tiger Lake Type-C IO Manager (Chromebook)"
